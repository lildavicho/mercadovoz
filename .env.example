# Entorno del backend: development conserva rutas de laboratorio; pilot las desactiva.
MERCADOVOZ_ENV=pilot

# Ruta persistente del SQLite del piloto. Obligatoria en pilot y fuera del código.
MERCADOVOZ_DB=/home/ubuntu/apps/mercadovoz/data/runtime/mercadovoz-pilot.db

# Objeto JSON secreto participant_id -> código. Obligatorio; no usar este ejemplo literalmente.
MERCADOVOZ_PILOT_ACCESS_CODES={"P01":"REEMPLAZAR-CON-CODIGO-LARGO"}

# Identificador de ronda obligatorio en pilot; evita mezclar versiones por fecha.
MERCADOVOZ_PILOT_ROUND_ID=P01_R2

# Token secreto del operador para métricas privadas. Obligatorio si se habilita esa ruta.
MERCADOVOZ_OPERATOR_TOKEN=REEMPLAZAR-CON-TOKEN-ALEATORIO

# Orígenes exactos del frontend, separados por coma. Obligatorio en pilot.
MERCADOVOZ_ALLOWED_ORIGINS=https://mercadovoz.example.invalid

# Inyectado normalmente por el proveedor; 8000 sirve para ejecución local.
PORT=8000
